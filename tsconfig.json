{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"esModuleInterop": true,
		"strict": true,
		"skipLibCheck": true,
		"outDir": "dist",
		"rootDir": "source",
		"declaration": true,
		"resolveJsonModule": true,
		"lib": ["ES2022"]
	},
	"include": ["source"],
	"exclude": ["node_modules", "dist"]
}
