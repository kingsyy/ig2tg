# Copy to .env on the QNAP and replace every value. Never commit .env.
# https://github.com/kingsyy/ig2tg/blob/master/docs/setup.md
TG_BOT_TOKEN=replace-with-BotFather-token
TG_SUPERGROUP_ID=-1001234567890
TG_OWNER_ID=123456789

# Optional startup behavior. Defaults are shown.
BRIDGE_BACKFILL_ON_START=true
BRIDGE_BACKFILL_COUNT=20

# Optional reliability tuning. Defaults are shown.
# Threads and recent messages inspected by a missed-message check (after a
# realtime reconnect, on startup, and on /sync). Higher values mean more
# Instagram REST calls per check.
BRIDGE_RECONCILE_THREAD_COUNT=10
BRIDGE_RECONCILE_MESSAGE_COUNT=30
# How long Instagram realtime must stay down before Telegram is warned.
BRIDGE_DISCONNECT_WARN_AFTER_SECONDS=45
# Bounded automatic attempts per outgoing message before it is left failed and
# available for /retry.
BRIDGE_OUTBOUND_MAX_ATTEMPTS=4
BRIDGE_OUTBOUND_RETENTION_DAYS=7

# Mirror messages you send from the Instagram app into Telegram as "📤 You: …".
BRIDGE_FORWARD_OWN_MESSAGES=true

# Leave unset. Setting DEBUG enables the underlying Instagram library's request
# logging, which writes message bodies and session cookies to the log file.
# DEBUG=ig:*
